[ext_resource type="Resource" path="res://resources/minions/whelp.tres" id="4_minion"]

[sub_resource type="Resource" id="Turn"]
script = ExtResource("2_beat")
id = &"turn_to_tank"
title = "Turn to the Tank"
rules_text = "Embermaw faces the guardian."
kind = 0
counter_tags = Array[StringName]([&"Position"])

[sub_resource type="Resource" id="Claw"]
script = ExtResource("2_beat")
id = &"raking_claw"
title = "Raking Claw"
rules_text = "Front arc, range 1."
kind = 1
counter_tags = Array[StringName]([&"Mitigate", &"Move"])
damage_classification = &"tank_hit"
damage = 4

[sub_resource type="Resource" id="Scar"]
script = ExtResource("2_beat")
id = &"claw_scorch"
title = "Ash Trail"
rules_text = "The struck front arc becomes Scorched."
kind = 2
counter_tags = Array[StringName]([&"Move"])
duration_rounds = 1
hazard = ExtResource("3_hazard")

[sub_resource type="Resource" id="Breath"]
script = ExtResource("2_beat")
id = &"cinder_breath"
title = "Cinder Breath"
rules_text = "Forward cone, range 1-2."
kind = 3
counter_tags = Array[StringName]([&"Move", &"Interrupt"])
damage = 5
duration_rounds = 1
hazard = ExtResource("3_hazard")

[sub_resource type="Resource" id="Brood"]
script = ExtResource("2_beat")
id = &"brood_call"
title = "Brood Call"
rules_text = "Whelps emerge at the marked edge hexes."
kind = 4
counter_tags = Array[StringName]([&"Kill Adds"])
minion = ExtResource("4_minion")
count = 2

[sub_resource type="Resource" id="Warning"]
script = ExtResource("2_beat")
id = &"heat_warning"
title = "Heat Rises"
rules_text = "The marked cone and spawn points resolve before Slow."
kind = 5
counter_tags = Array[StringName]([&"Move", &"Kill Adds"])

[resource]
script = ExtResource("1_program")
id = &"embermaw_brood"
title = "Brood Pattern"
rules_text = "Pressure the front while closing the party's escape lanes."
instant_beats = Array[ExtResource("2_beat")]([SubResource("Turn"), SubResource("Claw"), SubResource("Scar")])
incoming_beats = Array[ExtResource("2_beat")]([SubResource("Breath"), SubResource("Brood"), SubResource("Warning")])
