[gd_resource type="Resource" script_class="BossProgramData" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/boss/BossProgramData.gd" id="1_program"]
[ext_resource type="Script" path="res://scripts/boss/BossProgramBeat.gd" id="2_beat"]
[ext_resource type="Resource" path="res://resources/hazards/scorched.tres" id="3_hazard"]
[ext_resource type="Resource" path="res://resources/minions/whelp.tres" id="4_minion"]

[sub_resource type="Resource" id="Turn"]
script = ExtResource("2_beat")
id = &"turn_to_tank"
title = "Stalk the Guardian"
rules_text = "Embermaw turns to the guardian."
kind = 0
counter_tags = Array[StringName]([&"Position"])

[sub_resource type="Resource" id="Breath"]
script = ExtResource("2_beat")
id = &"cinder_breath"
title = "Cinder Breath"
rules_text = "Forward cone, range 1-2."
kind = 3
counter_tags = Array[StringName]([&"Move", &"Interrupt"])
damage = 5
duration_rounds = 1
hazard = ExtResource("3_hazard")

[sub_resource type="Resource" id="Scar"]
script = ExtResource("2_beat")
id = &"ember_scar"
title = "Ember Scar"
rules_text = "The cone remains Scorched."
kind = 2
counter_tags = Array[StringName]([&"Move"])
duration_rounds = 1
hazard = ExtResource("3_hazard")

[sub_resource type="Resource" id="Brood"]
script = ExtResource("2_beat")
id = &"brood_call"
title = "Brood Call"
rules_text = "Whelps emerge at the marked edge hexes."
kind = 4
counter_tags = Array[StringName]([&"Kill Adds"])
minion = ExtResource("4_minion")
count = 2

[sub_resource type="Resource" id="Claw"]
script = ExtResource("2_beat")
id = &"raking_claw"
title = "Raking Claw"
rules_text = "Front arc, range 1."
kind = 1
counter_tags = Array[StringName]([&"Mitigate", &"Move"])
damage = 4

[sub_resource type="Resource" id="Warning"]
script = ExtResource("2_beat")
id = &"ash_warning"
title = "Keep a Safe Hex"
rules_text = "Scorched ground blocks voluntary movement."
kind = 5
counter_tags = Array[StringName]([&"Move"])

[resource]
script = ExtResource("1_program")
id = &"embermaw_embers"
title = "Ember Pattern"
rules_text = "The arena narrows before Embermaw snaps at the front line."
instant_beats = Array[ExtResource("2_beat")]([SubResource("Turn"), SubResource("Breath"), SubResource("Scar")])
incoming_beats = Array[ExtResource("2_beat")]([SubResource("Brood"), SubResource("Claw"), SubResource("Warning")])
