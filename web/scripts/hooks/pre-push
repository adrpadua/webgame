#!/usr/bin/env bash
# The whole pre-merge gate, run where the code already is.
#
# There is no CI validation any more. `.github/workflows/` deploys the
# Workbench to Pages and does nothing else; everything that decides whether a
# change is good lives in the repository as scripts, and `npm run verify:local`
# is the one that runs all of them.
#
# The history is worth keeping, because it is the argument. The browser suite
# went first: `playwright install --with-deps` shells out to apt-get on a
# hosted runner, and a slow Ubuntu mirror turned the check red for reasons no
# author could act on. A gate that fails for reasons you cannot fix is one
# everybody learns to ignore, which is worse than not having it. The
# replacement was a self-hosted runner, which is a machine that can be off — a
# gate whose honesty depends on somebody's laptop being awake. The rest
# followed for the same reason: a check you can run yourself, in one command,
# is a check you can trust and fix.
#
# What the gate covers, in the order it runs: a browser is present, the Vitest
# suite, lint (which includes the engine-purity boundary rule), the production
# build, the browser smoke suite, and the mutation audit. Cheapest first, so a
# broken diff fails in seconds rather than minutes.
#
# Install with: cd web && npm run hooks:install
# Skip one push with: git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/web"

# Nothing to verify on a branch delete (`git push origin :branch`), and no
# working tree to build from either.
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "pre-push: branch delete, nothing to verify"
    exit 0
  fi
done

if [ ! -d node_modules ]; then
  echo "pre-push: web/node_modules is missing — run 'npm ci' in web/ first" >&2
  exit 1
fi

echo "pre-push: running the full gate (npm run verify:local)"
npm run verify:local
